{
  "manifest_version": 3,
  "name": "Galileo Haptic Feedback",
  "version": "0.1.0",
  "description": "Subtle Android haptic feedback for link presses and deliberate scrolling in Galileo Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "haptic-feedback@extensions.galileobrowser.com"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Galileo Haptic Feedback"
  },
  "galileo_platforms": [
    "android"
  ],
  "galileo_capabilities": {
    "vibration": "navigator.vibrate",
    "desktop_install": false
  }
}
