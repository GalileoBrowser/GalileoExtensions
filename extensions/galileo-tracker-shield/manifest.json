{
  "manifest_version": 3,
  "name": "Galileo Tracker Shield",
  "version": "0.2.0",
  "description": "Reviewed network blocking and cosmetic filtering for common advertising and tracking surfaces in Galileo Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tracker-shield@extensions.galileobrowser.com"
    }
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.adnxs.com/*",
    "*://*.adsrvr.org/*",
    "*://*.doubleclick.net/*",
    "*://*.googleadservices.com/*",
    "*://*.googlesyndication.com/*",
    "*://*.outbrain.com/*",
    "*://*.scorecardresearch.com/*",
    "*://*.taboola.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_shield_preview",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Galileo Tracker Shield"
  }
}
